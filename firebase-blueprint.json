{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "number", "description": "Timestamp of creation" },
        "companyName": { "type": "string" },
        "neq": { "type": "string" },
        "nas": { "type": "string" },
        "incomeBracket": { "type": "string" },
        "employeeCount": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "photoUrl": { "type": "string" }
      },
      "required": ["displayName", "email", "createdAt"]
    },
    "clientNeed": {
      "title": "ClientNeed",
      "description": "Needs declared by the client",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["userId", "type", "isActive"]
    },
    "document": {
      "title": "Document",
      "description": "Secure document uploaded by user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "uploadDate": { "type": "number" },
        "status": { "type": "string" },
        "mimeType": { "type": "string" },
        "metadata": { "type": "string" }
      },
      "required": ["userId", "fileName", "fileSize", "uploadDate", "status"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Financial transaction (Sale or Purchase)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["sale", "purchase"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "date": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "reconciled", "error"] },
        "category": { "type": "string" }
      },
      "required": ["userId", "type", "amount", "date", "status"]
    },
    "newsUpdate": {
      "title": "NewsUpdate",
      "description": "System or tax update news",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "number" },
        "type": { "type": "string" }
      },
      "required": ["title", "content", "date", "type"]
    },
    "message": {
      "title": "Message",
      "description": "Message in chat",
      "type": "object",
      "properties": {
        "senderType": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "readBy": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["senderType", "content", "timestamp", "chatId", "senderId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": {
        "$ref": "#/entities/user"
      },
      "description": "Stores user profiles"
    },
    "users/{userId}/clientNeeds/{needId}": {
      "schema": {
        "$ref": "#/entities/clientNeed"
      },
      "description": "Stores user specific needs"
    },
    "users/{userId}/documents/{documentId}": {
      "schema": {
        "$ref": "#/entities/document"
      },
      "description": "Stores user documents"
    },
    "users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/transaction"
      },
      "description": "Stores user financial transactions"
    },
    "newsUpdates/{updateId}": {
      "schema": {
        "$ref": "#/entities/newsUpdate"
      },
      "description": "Global news updates"
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/message"
      },
      "description": "Stores messages in a top level chat collection with messages subcollection"
    }
  }
}
