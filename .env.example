# --- CONFIGURATION COMPTAFLOW ---

# SUPABASE (Base de données & Auth)
# Obtenez ces valeurs sur https://supabase.com
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Clé service role — API serveur uniquement (création sub-admins, webhooks). Ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AGENTS IA & API INTERNE
# Gemini — routage support client (/api/support/ai-chat) et CLI agents
GOOGLE_GEMINI_API_KEY="your-gemini-api-key"
# Secret admin — Bearer sur /api/internal/* et header X-ComptaFlow-Internal
ADMIN_SECRET="your-admin-secret"

# AUTOMATION (n8n / Bus d'événements)
# URLs des webhooks réels pour les notifications critiques
VITE_N8N_INVOICE_WEBHOOK_URL="https://your-n8n-instance.com/webhook/invoice-alert"
VITE_N8N_SUBSCRIPTION_WEBHOOK_URL="https://your-n8n-instance.com/webhook/subscription-report"

# PAIEMENT (Stripe & PayPal)
VITE_STRIPE_PUBLIC_KEY="pk_live_..."
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

VITE_PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"

# INFRASTRUCTURE REDONDANTE (Optionnel)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
