# ComptaFlow — variables d'environnement (copier vers .env.local)

# Supabase (client Vite — préfixe VITE_)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase (serveur — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Mot de passe DB (Settings → Database) — pour npm run db:migrate uniquement
SUPABASE_DB_PASSWORD=

# Assistant support (Gemini)
GOOGLE_GEMINI_API_KEY=

# Endpoints internes / cron
ADMIN_SECRET=
CRON_SECRET=

# Email transactionnel (onboarding, notifications)
RESEND_API_KEY=

# Paiements serveur (optionnel)
STRIPE_SECRET_KEY=

# Webhooks n8n (optionnel)
VITE_N8N_INVOICE_WEBHOOK_URL=
VITE_N8N_SUBSCRIPTION_WEBHOOK_URL=

# Paiements (optionnel)
VITE_STRIPE_PUBLIC_KEY=
VITE_PAYPAL_CLIENT_ID=

# ─── Google OAuth (Supabase Auth) ───────────────────────────────────────────
# Aucune clé Google côté app : configurez dans Supabase Dashboard.
#
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
#    - Authorized redirect URI: https://YOUR_PROJECT.supabase.co/auth/v1/callback
# 2. Supabase → Authentication → Providers → Google → Client ID + Secret
# 3. Supabase → Authentication → URL Configuration → Redirect URLs :
#    - http://localhost:5173/auth/callback
#    - https://compta-flow.net/auth/callback
