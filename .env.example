# ComptaFlow — variables d'environnement (copier vers .env.local)

# Supabase — canonical prod project: unvyxfxlzhnutpugjxhe
# Supabase — client Vite (local dev)
VITE_SUPABASE_URL=https://unvyxfxlzhnutpugjxhe.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase — Vercel integration (auto-injected in Production; same names work locally)
SUPABASE_URL=https://unvyxfxlzhnutpugjxhe.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Service role — server only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alias from Vercel Supabase integration:
SUPABASE_SECRET_KEY=your-service-role-key
# Mot de passe DB (Settings → Database) — pour npm run db:migrate uniquement
SUPABASE_DB_PASSWORD=

# Assistant support (Gemini)
GOOGLE_GEMINI_API_KEY=

# Endpoints internes / cron
ADMIN_SECRET=
CRON_SECRET=

# Email transactionnel (onboarding, notifications)
RESEND_API_KEY=

# Paiements serveur (optionnel)
STRIPE_SECRET_KEY=

# Seed admins (local/CI — ne jamais committer)
# PowerShell: $env:SEED_ADMIN_PASSWORD="..."; npm run seed:admins
# Cross-platform: npm run seed:admins -- --password=...
SEED_ADMIN_PASSWORD=

# Webhooks n8n (optionnel)
VITE_N8N_INVOICE_WEBHOOK_URL=
VITE_N8N_SUBSCRIPTION_WEBHOOK_URL=

# Paiements (optionnel)
VITE_STRIPE_PUBLIC_KEY=
VITE_PAYPAL_CLIENT_ID=
