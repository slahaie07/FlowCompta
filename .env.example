# ComptaFlow — variables d'environnement (promotion)
# Copier vers .env.local pour le dev local. Ne jamais committer de secrets réels.

# ── Supabase (client — exposées au build Vite) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# ── Supabase (serveur — Vercel Production uniquement) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
# Requis pour webhooks onboarding, admin, réconciliation live
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── IA (support client + OCR) ──
GOOGLE_GEMINI_API_KEY=your_gemini_api_key
# Sans clé : mode mock-fallback (réponses guidées locales, pas de crash)

# ── Sécurité interne ──
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=generate_a_long_random_secret
CRON_SECRET=generate_another_random_secret

# ── Email ──
RESEND_API_KEY=re_your_resend_key

# ── Paiements (optionnel) ──
STRIPE_SECRET_KEY=sk_live_or_test_...
VITE_STRIPE_PUBLIC_KEY=pk_live_or_test_...
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# ── SMS alertes (optionnel) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── n8n webhooks (optionnel — facturation / abonnements) ──
VITE_N8N_INVOICE_WEBHOOK_URL=https://your-n8n.app/webhook/comptaflow-invoice
VITE_N8N_SUBSCRIPTION_WEBHOOK_URL=https://your-n8n.app/webhook/comptaflow-stripe-webhook

# ── Dev local ──
PORT=3000
NODE_ENV=development

# ── Instructions Supabase RLS ──
# Appliquer manuellement dans SQL Editor :
#   supabase/migrations/20260619_rls_hardening.sql

# ── Vérification pré-lancement ──
#   npm run promotion:check
