# n8n local — copier vers .env.n8n (ne pas committer)
# docker compose lit ce fichier automatiquement

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# Compte propriétaire (utilisé par npm run n8n:setup)
N8N_OWNER_EMAIL=comptaflow@compta-flow.local
N8N_OWNER_FIRST_NAME=ComptaFlow
N8N_OWNER_LAST_NAME=Admin
# Laissez vide pour générer un mot de passe aléatoire :
N8N_OWNER_PASSWORD=

# Variable pour les workflows ComptaFlow ( = ADMIN_SECRET sur Vercel )
COMPTAFLOW_ADMIN_SECRET=
COMPTAFLOW_API_URL=https://compta-flow.net
COMPTAFLOW_ALERT_EMAIL=support@compta-flow.net
