{
  "name": "ComptaFlow - Onboarding Automatisé (Interac)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "comptaflow-onboarding",
        "options": {}
      },
      "id": "webhook-onboarding",
      "name": "Webhook onboarding client",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [100, 300],
      "webhookId": "comptaflow-onboarding-trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://compta-flow.net/api/webhook/onboarding-complete",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"userId\": \"{{ $json.body.userId }}\",\n  \"email\": \"{{ $json.body.email }}\",\n  \"displayName\": \"{{ $json.body.displayName }}\",\n  \"province\": \"{{ $json.body.province || 'QC' }}\",\n  \"language\": \"{{ $json.body.language || 'fr' }}\"\n}",
        "options": {}
      },
      "id": "call-comptaflow",
      "name": "Courriel bienvenue ComptaFlow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, 300]
    },
    {
      "parameters": {
        "resource": "folder",
        "name": "={{ $json.body.displayName || $json.body.email }} - Archives Fiscales",
        "parentFolder": "YOUR_ROOT_FOLDER_ID"
      },
      "id": "drive-folder",
      "name": "Dossier Google Drive client",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [620, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "YOUR_GOOGLE_DRIVE_ID",
          "name": "Google Drive Account"
        }
      }
    }
  ],
  "connections": {
    "Webhook onboarding client": {
      "main": [[{ "node": "Courriel bienvenue ComptaFlow", "type": "main", "index": 0 }]]
    },
    "Courriel bienvenue ComptaFlow": {
      "main": [[{ "node": "Dossier Google Drive client", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "onboarding" }, { "name": "compta-flow" }],
  "meta": {
    "description": "Déclencher depuis Supabase (nouveau profil) ou manuellement. Corps: { userId, email, displayName, province, language }. Pas de Stripe — onboarding après inscription."
  }
}
