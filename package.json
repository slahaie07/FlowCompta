{
  "name": "comptaflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "verify:network": "tsx scripts/verify-canada-network.ts",
    "build": "vite build && esbuild api/app.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=api/index.js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "ci": "npm run lint && npm test && npm run verify:canada-module && npm run build",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "verify:canada-module": "tsx scripts/verify-canada-module.ts",
    "promotion:check": "tsx scripts/promotion-check.ts",
    "db:migrate": "tsx scripts/apply-supabase-migrations.ts",
    "vercel:sync-env": "tsx scripts/sync-vercel-env.ts",
    "finish:setup": "tsx scripts/finish-production-setup.ts",
    "setup:all": "npm run ci && npm run finish:setup && npm run verify:network",
    "deploy:admins": "powershell -ExecutionPolicy Bypass -File scripts/deploy-admins.ps1",
    "seed:admins": "tsx scripts/seed-admin-users.ts",
    "seed:admins:dry-run": "tsx scripts/seed-admin-users.ts --dry-run",
    "setup:print-sql": "tsx scripts/print-setup-sql.ts",
    "setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "agents:list": "tsx scripts/agents-cli.ts --list",
    "agents:ask": "tsx scripts/agents-cli.ts",
    "n8n:up": "docker compose up -d n8n",
    "n8n:down": "docker compose down",
    "n8n:setup": "tsx scripts/n8n-create-account.ts",
    "n8n:import": "tsx scripts/n8n-import-workflows.ts",
    "n8n:bootstrap": "tsx scripts/n8n-bootstrap.ts",
    "ping:search": "tsx scripts/ping-search-engines.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@google/generative-ai": "^0.21.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@supabase/supabase-js": "^2.108.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.21.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "resend": "^3.2.0",
    "sonner": "^2.0.7",
    "twilio": "^6.0.2",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8"
  }
}
